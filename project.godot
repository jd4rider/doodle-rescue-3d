; Doodle Rescue 3D — Godot 4.7 project configuration

config_version=5

[application]

config/name="Doodle Rescue 3D"
config/version="0.2.0"
config/description="A 3D physics drawing adventure: sketch real beams, shelters and ramps to keep Biscuit safe."
run/main_scene="res://Scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.10, 0.16, 0.24, 1)
boot_splash/show_image=false

[autoload]

Save="*res://Scripts/Core/SaveManager.gd"
Audio="*res://Scripts/Core/AudioManager.gd"
Arcade="*res://Scripts/Core/ArcadeBridge.gd"
Levels="*res://Scripts/Core/Levels.gd"
Router="*res://Scripts/Core/Router.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=430
window/size/window_height_override=764
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/handheld/orientation=1
window/size/resizable=true

[gui]

theme/default_font_multichannel_signed_distance_field=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.10, 0.16, 0.24, 1)

[audio]

driver/mix_rate=44100

[input_devices]

; Godot's web export can deliver one finger as both a touch and an emulated
; mouse click. DrawEngine reads both event kinds itself, so both emulation
; directions stay off and one finger is one stroke.
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=18.0
